# CrowdCompass Rover backend — copy to .env and fill in for APP_MODE=real
APP_MODE=mock                 # mock | real | hybrid

# Elasticsearch
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=cc-city-events

# Elastic MCP server
ELASTIC_MCP_URL=
ELASTIC_MCP_API_KEY=

# Gemini / Vertex
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud (deploy only)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional enrichment
GOOGLE_MAPS_API_KEY=

# Server
CORS_ORIGINS=http://localhost:5173
